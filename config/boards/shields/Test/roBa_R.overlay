#include "roBa.dtsi"
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

&default_transform {
    col-offset = <6>;
};

/* 1. キーマトリクスの修正 */
/* 列の数を5つに保ちつつ、D9ピン(xiao_d 9)の競合を避けるためダミーピンに割り当てます */
&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&gpio0 11 GPIO_ACTIVE_HIGH>  /* D9の代わりに未使用ピン(P0.11)をダミーとして設定 */
        , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
        , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

&i2c0 { status = "disabled"; };

/* 2. トラックボールの回転設定（90度補正用） */
/* XとYを入れ替え(Swap)し、必要なら反転(Invert)させます */
/ {
    trackball_rotate: trackball_rotate {
        compatible = "zmk,input-processor-transform";
        xy-swap;
        x-invert; /* 90度回転の場合、Swapに加えて片方の軸の反転が必要なことが多いです */
    };
};

/* 3. トラックボール設定 */
/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /* ① レイヤー5の時：スクロール */
        scroller {
            layers = <5>;
            /* スクロールマッパーを適用 */
            input-processors = <&zip_xy_to_scroll_mapper>;
        };

        /* ② それ以外の時：カーソル移動（回転補正付き） */
        default_movement {
            layers = <0 1 2 3 4 6>;
            /* 定義した回転設定を適用 */
            input-processors = <&trackball_rotate>;
        };
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        res-cpi = <600>;
        
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
    };
};
