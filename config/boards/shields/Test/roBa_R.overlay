#include "roBa.dtsi"
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

&default_transform {
    col-offset = <6>;
};

/* ▼▼▼ 1. キーマトリクス（ここだけは修正が必要です） ▼▼▼ */
/* * 動いていたコードでは D9 (xiao_d 9) が含まれていましたが、
 * トラックボール(CSピン)と競合するため、ここだけは「ダミーピン」に置き換えます。
 * これをしないと、キー入力がおかしくなるか、接続エラーになります。
 */
&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&gpio0 11 GPIO_ACTIVE_HIGH>  /* 元の D9 の代わりに使わないピン(P0.11)を設定 */
        , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
        , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

/* トラックボールのリスナー設定 */
/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /* ▼▼▼ 2. スクロール設定 (標準機能を使用) ▼▼▼ */
        scroll {
            layers = <5>;
            input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 64>;
        };

        /* ▼▼▼ 3. マウス移動と回転 (標準機能を使用) ▼▼▼ */
        /* * 独自に trackball_rotate を作るのではなく、
         * 最初から入っている &zip_xy_transform を使い、
         * カッコの中に「どう回転させるか」の指令(フラグ)を書きます。
         */
        move {
            layers = <0 1 2 3 4 6>;
            input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)>;
        };
    };
};

/* 以下は「動いていたコード」と全く同じ設定です */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    
    /* トラックボールのCSピン (ここが D9 なのでマトリクスからは外す必要がある) */
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        res-cpi = <600>;
        
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
    };
};
