#include "roBa.dtsi"
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH> 
        , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
        , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

/* ▼▼▼ トラックボールの挙動設定（修正版） ▼▼▼ */
/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /* ① レイヤー5の時：スクロールモード */
        scroller {
            layers = <5>;
            input-processors = <&zip_xy_to_scroll_mapper>
                             , <&zip_scroll_scaler 1 64>;
        };

        /* ② それ以外の時：マウスカーソル移動 */
        default_movement {
            /* 【重要】ここに普段使うレイヤー番号をすべて列挙してください */
            /* 例: レイヤー5以外 (0, 1, 2, 3, 4, 6) */
            layers = <0 1 2 3 4 6>; 
            input-processors = <&zip_xy_scaler 1 1>;
        };
    };
};

/* ▼▼▼ ピン設定（動いた実績のある設定を維持） ▼▼▼ */
&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    
    /* 動いた時のCSピン設定を維持 */
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        res-cpi = <600>;
        
        /* ▼▼▼ 向きの修正箇所 ▼▼▼ */
        /* 90度ずれていたため、入れ替えをやめて標準に戻しました */
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
    };
};

/* これがないと、SPI通信（トラックボール）とI2Cがケンカして接続が切れます */
&i2c0 {
    status = "disabled";
};
