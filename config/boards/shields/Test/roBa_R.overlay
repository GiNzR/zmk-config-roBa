#include "roBa.dtsi"
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/input/input-event-codes.h>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>

&default_transform {
    col-offset = <6>;
};

/* ▼▼▼ 1. キーマトリクス設定（接続エラー対策） ▼▼▼ */
/* D9ピンを除外し、列数(5)を維持するためにダミーピン(gpio0 11)を設定 */
&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&gpio0 11 GPIO_ACTIVE_HIGH> 
        , <&xiao_d 8 GPIO_ACTIVE_HIGH> 
        , <&xiao_d 7 GPIO_ACTIVE_HIGH> 
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

&i2c0 { status = "disabled"; };

/* ▼▼▼ 2. トラックボール設定（ZMK標準機能を使用） ▼▼▼ */
/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        /* ① レイヤー5の時：スクロール */
        scroller {
            layers = <5>;
            input-processors = <&zip_xy_to_scroll_mapper>;
        };

        /* ② それ以外の時：カーソル移動（90度回転適用） */
        default_movement {
            layers = <0 1 2 3 4 6>;
            /* * ここで回転を設定します。
             * INPUT_TRANSFORM_XY_SWAP : 縦横の入れ替え
             * INPUT_TRANSFORM_Y_INVERT : Y方向の反転
             * (組み合わせることで90度回転を実現しています)
             */
            input-processors = <&zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT)>;
        };
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>;
        };
    };
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        motion-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        res-cpi = <600>;
        
        zephyr,axis-x = <INPUT_REL_X>;
        zephyr,axis-y = <INPUT_REL_Y>;
    };
};
